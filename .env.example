# Recommended: node scripts/setup-handoff.mjs generates a local password.
# For an existing local PostgreSQL installation, fill these values yourself.
POSTGRES_USER=ctv
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=ctv_handoff
POSTGRES_PORT=5434
DATABASE_URL=postgresql://ctv:replace-with-your-local-password@127.0.0.1:5434/ctv_handoff
BETA_AUTH_ENABLED=false
